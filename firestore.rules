rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Contributions collection - readable and writable by web app for submitting and moderation
    match /contributions/{contributionId} {
      allow read, write: if true;
    }

    // Contributors (Hall of Fame / Leaderboard)
    match /contributors/{contributorId} {
      allow read, write: if true;
    }

    // Catch all other documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
