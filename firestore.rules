rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Contributions collection - allow guest submissions with status == 'pending', allow moderation operations
    match /contributions/{contributionId} {
      allow create: if request.resource.data.status == 'pending';
      allow read, update, delete: if true;
    }

    // Contributors (Hall of Fame / Leaderboard) - public read, write for atomic transactions & updates
    match /contributors/{contributorId} {
      allow read: if true;
      allow write: if true;
    }

    // Feedbacks & Announcements
    match /feedbacks/{feedbackId} {
      allow read, write: if true;
    }

    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    // Catch all other documents
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

