# ==============================================================================
# HCMUE FIT STUDYVAULT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE PUBLIC CONFIGURATION (Vite - import.meta.env.VITE_*)
# (Consumes public Firebase Web SDK identifiers only - Zero secrets)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE SECRETS (Node.js/Express - process.env - NEVER EXPOSE TO CLIENT/GIT)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Server-side secret for Gemini AI API calls (Assistant, OCR, etc.)
GEMINI_API_KEY=""

# ADMIN_PASSWORD: Password for backend administrator authentication (/api/admin/login)
ADMIN_PASSWORD=""

# APP_URL: Base URL where the application is hosted
APP_URL="http://localhost:3000"

# PORT: Server listener port (Default: 3000)
PORT=3000

# ------------------------------------------------------------------------------
# 3. BACKEND FIREBASE RUNTIME CONFIGURATION (Optional process.env fallback)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=""
FIREBASE_APP_ID=""
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_FIRESTORE_DATABASE_ID=""
FIREBASE_STORAGE_BUCKET=""
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_MEASUREMENT_ID=""
FIREBASE_OAUTH_CLIENT_ID=""
FIREBASE_RECAPTCHA_SITE_KEY=""
